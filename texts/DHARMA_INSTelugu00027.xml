         <div type="edition" xml:lang="tel-Latn">
            <p>
               <milestone unit="face" n="a"/><lb n="1"/><g ref="sym:spiral-right" type="symbol">*</g> svasti śrīmaT <g ref="sym:bar-hooked" type="punctuation">.</g> satyāśraya<milestone unit="face" n="b" break="no"/>-śrī-<sic>pr̥i</sic>thivī<milestone unit="face" n="a" break="no"/><lb n="2" break="no"/>-vallabha-mahārājādhirāja-vi<milestone unit="face" n="b" break="no"/>kramāditya-paramē<milestone unit="face" n="a" break="no"/><lb n="3" break="no"/>śvara-bhaṭaruḷāku<unclear>N</unclear> śrīmad-unnata-prava<milestone unit="face" n="b" break="no"/>rddhamāna-vijaya<milestone unit="face" n="a" break="no"/><lb n="4" break="no"/>rājya-saṁvatsaraṁbuḶ Ācandratāra<milestone unit="face" n="b" break="no"/>purassaraM<milestone unit="face" n="a" break="no"/><lb n="5"/>dvitīya-varṣam-prava<add place="below">rta</add>mānaṁ kānu goggi<milestone unit="face" n="b" break="no"/>-bhaṭaraḷa dakṣiṇa<milestone unit="face" n="a" break="no"/><lb n="6" break="no"/>bhujāyamānuṁṟ<!-- it seems to be a denominal derivation from bhuja- 'arm'; quasi "holding the south in his arm/grip" --> ayina ālakuma<unclear>ra</unclear><!-- I cannot see any ⟨ra⟩ --><milestone unit="face" n="b" break="no"/>priya-tana<choice><orig>yi</orig><reg>yu</reg></choice>ṁṟ ayina
               <lb n="7"/>Ujēnīpiśāca-nāmadhē<choice><orig>yi</orig><reg>yu</reg></choice>ṁṟu <unclear>tuṟu</unclear>-taṭāka-nāmābhi<lb n="8" break="no"/>dhāna-naga<choice><orig>radhī</orig><reg>rādhi</reg></choice>ṣṭhāṇuṁṟ ayi Ēṟuva-<unclear>viṣa</unclear>yaṁb ēḷan<!-- halanta? --> tasya
               <lb n="9"/>mā<choice><sic>tā</sic><corr>trā</corr></choice> dattaṁ gōvr̥ṣāṇa-bhaṭṭārahō śata-paṁcāśat kṣētram<!-- halanta? -->
               <lb n="10"/>svadattāṁ paradattāṁ vā yō harē<choice><sic>ti</sic><corr>ta</corr></choice> vasuṁdharā<unclear>M</unclear>
               <lb n="11"/>ṣa<choice><sic>ṣṭhiṁ</sic><corr>ṣṭiṁ</corr></choice>varṣa-sahasrāṇi viṣṭhāyāṁ jā<lb n="12" break="no"/>yatē krimiḥ
            </p>
