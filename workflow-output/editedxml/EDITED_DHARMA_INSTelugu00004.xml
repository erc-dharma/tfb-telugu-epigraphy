         <div type="edition" xml:lang="tel-Latn">
            <ab>
              <lb n="1"/>śrī cōḷaṟaviti
            </ab>
         </div>
         <div type="apparatus">
           <!--apparatus encoded as per EGD §9.1, basic elements for apparatus below-->
